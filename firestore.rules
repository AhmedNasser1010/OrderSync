rules_version = '2';

// =========================================================================
// FOOD-DELIVERY PLATFORM — FIRESTORE SECURITY RULES
//
// Apps served by this ruleset:
//   customer_app        -> customers place/track orders, leave reviews
//   orders_app          -> restaurant staff manage orders for 1 business
//   driver_app           -> couriers claim / deliver orders from marketplace
//   manager_app          -> restaurant managers view analytics and reports
//   onboarding_app       -> partners onboard & own one or more businesses
//
// Architecture:
//   orders/{orderId}     -> flat global collection, no subcollections
// =========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // HELPER FUNCTIONS
    // =====================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function resourceData() {
      return resource.data;
    }

    function incomingData() {
      return request.resource.data;
    }

    function hasUsersDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasCustomerDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/customers/$(request.auth.uid));
    }

    function getUsersDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getManagerBusiness() {
      return get(/databases/$(database)/documents/businesses/$(managerAccessToken())).data;
    }

    function isCustomer() {
      return hasCustomerDoc();
    }

    function isManager() {
      return hasUsersDoc() && getUsersDoc().userInfo.role == 'BUSINESS_MANAGER';
    }

    function isPartner() {
      return hasUsersDoc() && getUsersDoc().userInfo.role == 'BUSINESSES_CREATOR';
    }

    function isRider() {
      return isSignedIn() && exists(/databases/$(database)/documents/drivers/$(request.auth.uid));
    }

    function managerAccessToken() {
      return hasUsersDoc() ? getUsersDoc().accessToken : null;
    }

    function isManagerOf(businessId) {
      return isManager() && managerAccessToken() == businessId;
    }

    function partnerOwnsToken(token) {
      return hasUsersDoc() && token in getUsersDoc().data.businesses;
    }

    function isPartnerOwner(partnerUid) {
      return isPartner() && isOwner(partnerUid);
    }

    // =====================================================================
    // /users/{userId}
    // =====================================================================
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) || isPartnerOwner(incomingData().partnerUid);
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['userInfo'])
        && request.resource.data.userInfo.role == resource.data.userInfo.role;
      allow update: if isPartner()
        && isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['data']);
      allow update, delete: if isPartnerOwner(resourceData().partnerUid);
    }

    // =====================================================================
    // /reviews/{reviewId}
    // =====================================================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isCustomer();
      allow update: if ((isPartner() && partnerOwnsToken(resourceData().restaurantId))
        || isManagerOf(resourceData().restaurantId))
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['hidden', 'hiddenAt', 'hiddenBy', 'updatedAt'])
        && request.resource.data.hidden is bool
        && (request.resource.data.hidden == true
          ? (request.resource.data.hiddenAt is number
            && request.resource.data.hiddenBy is string)
          : (request.resource.data.hiddenAt == null
            && request.resource.data.hiddenBy == null));
      allow delete: if false;
    }

    // =====================================================================
    // /businesses/{busId}
    // =====================================================================
    match /businesses/{busId} {
      allow read: if true;
      allow create: if isPartnerOwner(incomingData().partnerUid);
      allow update: if isCustomer()
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['reviewSummary']);
      allow update: if isManagerOf(busId);
      allow update, delete: if isPartnerOwner(resourceData().partnerUid);
    }

    // =====================================================================
    // /menus/{menuId}
    // =====================================================================
    match /menus/{menuId} {
      allow read: if true;
      allow create: if isPartnerOwner(incomingData().partnerUid);
      allow update, delete: if isPartner() &&
        partnerOwnsToken(resourceData().accessToken);
    }

    // =====================================================================
    // /banners/{bannerId}
    //
    // Global homepage hero cards. Publicly readable so the customer app can
    // show them to everyone; only partners can manage them.
    // =====================================================================
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isPartner();
    }

    // =====================================================================
    // /services/{serviceId}
    //
    // Global platform config (e.g. delivery fee rates). Publicly readable
    // so the customer app can display correct pricing; partners edit it
    // from the onboarding app Settings page.
    // =====================================================================
    match /services/{serviceId} {
      allow read: if true;
      allow create, update: if isPartner();
      allow delete: if false;
    }

    // =====================================================================
    // /customers/{userId}
    // =====================================================================
    match /customers/{userId} {
      allow get: if isOwner(userId);
      allow list: if isPartner();
      allow create: if isOwner(userId)
        && incomingData().userInfo.role == 'CUSTOMER';
      allow update: if isCustomer() && isOwner(userId);
      allow update: if isPartner() && resourceData().partnerUid == request.auth.uid;
      allow delete: if false;
    }

    // =====================================================================
    // /drivers/{driverId}
    // =====================================================================
    match /drivers/{driverId} {
      allow read: if isOwner(driverId);
      allow read: if isCustomer() &&
        resourceData().trackingCustomerIds != null &&
        request.auth.uid in resourceData().trackingCustomerIds;
      allow read: if isManagerOf(resourceData().accessToken);
      allow read: if isPartnerOwner(resourceData().partnerUid);
      allow create: if isPartnerOwner(incomingData().partnerUid);
      allow update: if isOwner(driverId);
      allow update: if isManagerOf(resourceData().accessToken);
      allow update: if isPartner() && resourceData().partnerUid == request.auth.uid;
      allow delete: if isManagerOf(resourceData().accessToken);
      allow delete: if isPartner() && resourceData().partnerUid == request.auth.uid;
    }

    // =====================================================================
    // /orders/{orderId}
    //
    // Flat global collection. No subcollections.
    // Every order document contains:
    //   - accessToken, customer.uid, assignment.driverUid
    //   - status.current, status.history[]
    //   - timeline, pricing, finance
    // =====================================================================
    match /orders/{orderId} {

      // --- READ permissions ---

      // Customers can read orders they placed.
      // resource == null lets an order listener resolve exists() == false
      // (instead of permission-denied) when the order doc isn't created yet,
      // so the transient listener keeps running and picks up the order once it appears.
      allow read: if resource == null
        || (isCustomer()
          && resourceData().customer.uid == request.auth.uid);

      // Managers can read orders for their business.
      allow read: if resource == null
        || (isManager()
          && resourceData().businessId == managerAccessToken());

      // Partners can read orders for their businesses.
      allow read: if resource == null
        || (isPartner()
          && resourceData().businessId in partnerBusinessIds());

      // Drivers can read READY orders (marketplace browsing).
      // Returned orders (status.returnedByDriverUid != null) are restaurant-only
      // until the restaurant re-releases them.
      allow read: if resource == null
        || (isRider()
          && resourceData().status.current == 'READY'
          && resourceData().status.returnedByDriverUid == null);

      // Drivers can read PREPARING orders ("almost ready" preview when the
      // marketplace is empty). View-only: claiming still requires READY.
      allow read: if resource == null
        || (isRider()
          && resourceData().status.current == 'PREPARING');

      // Drivers can read orders assigned to them.
      allow read: if resource == null
        || (isRider()
          && resourceData().assignment != null
          && resourceData().assignment.driverUid == request.auth.uid);

      // --- CREATE permissions ---

      // Orders are created exclusively by the Next.js server action
      // (Admin SDK, which bypasses rules). Customers can never create
      // order documents directly, so pricing/discounts cannot be forged.

      // --- UPDATE permissions ---

      // Customers can cancel their own order (only from RECEIVED status).
      allow update: if isCustomer()
        && resourceData().customer.uid == request.auth.uid
        && resourceData().status.current == 'RECEIVED'
        && incomingData().status.current == 'CANCELED'
        && incomingData().diff(resourceData()).affectedKeys()
            .hasOnly(['status', 'timeline', 'updatedAt']);

      // Managers can update their business orders.
      // Once a driver claims the order (RESERVED, PICKED_UP, ON_ROUTE),
      // the manager cannot make any changes.
      allow update: if isManager()
        && resourceData().businessId == managerAccessToken()
        && !(resourceData().status.current in ['RESERVED', 'PICKED_UP', 'ON_ROUTE'])
        && incomingData().diff(resourceData()).affectedKeys()
            .hasOnly(['status', 'timeline', 'updatedAt']);

      // Drivers can claim a READY order (RESERVED transition).
      // Returned orders are not claimable until the restaurant re-releases them.
      allow update: if isRider()
        && resourceData().status.current == 'READY'
        && resourceData().status.returnedByDriverUid == null
        && incomingData().status.current == 'RESERVED'
        && incomingData().assignment.driverUid == request.auth.uid
        && incomingData().diff(resourceData()).affectedKeys()
            .hasOnly(['status', 'timeline', 'assignment', 'updatedAt']);

      // Drivers can update their assigned orders (PICKED_UP, ON_ROUTE, DELIVERED).
      // A driver may only reach READY by returning the order (returnedByDriverUid
      // must be set to their uid), never by silently releasing it to the marketplace.
      allow update: if isRider()
        && resourceData().assignment.driverUid == request.auth.uid
        && (incomingData().status.current != 'READY'
          || incomingData().status.returnedByDriverUid == request.auth.uid)
        && incomingData().diff(resourceData()).affectedKeys()
            .hasOnly(['status', 'timeline', 'assignment', 'updatedAt']);

      // Customers can submit feedback on delivered orders.
      allow update: if isCustomer()
        && resourceData().customer.uid == request.auth.uid
        && resourceData().status.current == 'DELIVERED'
        && incomingData().status.current == 'GIVEN_FEEDBACK'
        && incomingData().diff(resourceData()).affectedKeys()
            .hasOnly(['status', 'timeline', 'customerFeedback', 'updatedAt']);

      // --- DELETE permissions ---

      // Partners can permanently delete orders belonging to their
      // businesses, but only once they are in a terminal state.
      // Active orders can never be deleted, so live customer/driver
      // flows cannot be disrupted.
      allow delete: if isPartner()
        && resourceData().businessId in partnerBusinessIds()
        && resourceData().status.current in ['DELIVERED', 'GIVEN_FEEDBACK', 'CANCELED', 'REJECTED', 'VOIDED'];
    }

    // =====================================================================
    // Helper: returns list of business IDs owned by the authenticated partner
    // Used in /orders/{orderId} rules for partner read access.
    // =====================================================================
    function partnerBusinessIds() {
      return hasUsersDoc() ? getUsersDoc().data.businesses : [];
    }
  }
}
